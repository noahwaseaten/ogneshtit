{
  "name": "shtit",
  "version": "2.0.0",
  "private": true,
  "description": "Щит / Shield: ОгнеЩит (forest fires) and ВодоЩит (floods), free apps for people in Bulgaria.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noahwaseaten/ogneshtit.git"
  },
  "homepage": "https://shield.noahwaseaten.com",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:fire": "npm run dev -w @shtit/fire",
    "dev:flood": "npm run dev -w @shtit/flood",
    "dev:hub": "npm run dev -w @shtit/hub",
    "typegen": "npm run typegen --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
